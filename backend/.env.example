# TaskFlow Backend Environment Configuration
DEBUG=True
SECRET_KEY=django-insecure-taskflow-dev-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# Database Configuration (Defaults to SQLite for local development)
DATABASE_URL=sqlite:///db.sqlite3

# Channels Layer (InMemoryChannelLayer for local development, Redis for production)
CHANNEL_LAYER=inmemory
# REDIS_URL=redis://127.0.0.1:6379/0
